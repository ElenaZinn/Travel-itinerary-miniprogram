.page {
  min-height: 100vh;
  background: var(--bg-page);
}

.header {
  background: linear-gradient(135deg, #1a2b3c 0%, #2a3b4c 100%);
  padding: 48rpx;
  color: #f0f4f8;
}

.header-title {
  font-size: 48rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.header-subtitle {
  font-size: 28rpx;
  opacity: 0.72;
}

.destination-list {
  padding: 28rpx 32rpx 88rpx;
}

/* Available / Coming Soon tabs with an underline indicator */
.dest-tabs {
  position: relative;
  display: flex;
  background: var(--bg-card);
  border-bottom: 1rpx solid #e3e8ee;
}

.dest-tab {
  flex: 1;
  text-align: center;
  padding: 26rpx 0 22rpx;
  color: var(--text-sub);
  font-size: 30rpx;
  line-height: 1.2;
}

.dest-tab.active {
  color: var(--text-main);
  font-weight: 700;
}

.dest-tab-count {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: var(--text-hint);
}

.dest-tab.active .dest-tab-count {
  color: #00b7a4;
}

.dest-tab-indicator {
  position: absolute;
  bottom: -1rpx;
  left: 0;
  width: 50%;
  height: 6rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: left .25s ease;
}

.dest-tab-indicator-bar {
  width: 72rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background: var(--primary);
}

.destination-item {
  background: var(--bg-card);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: var(--shadow);
}

.destination-item.disabled {
  opacity: 0.6;
}

.destination-content {
  display: flex;
  align-items: center;
  flex: 1;
}

.destination-flag {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  background: #e8edf2;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}
.destination-flag-emoji {
  line-height: 1;
  flex-shrink: 0;
}

.destination-info {
  flex: 1;
}

.destination-name {
  font-size: 32rpx;
  color: var(--text-main);
  font-weight: 500;
}

.coming-soon-tag {
  background: #f5f5f5;
  color: var(--text-hint);
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.arrow-icon {
  font-size: 48rpx;
  color: #cccccc;
  font-weight: 300;
}

/* Demo content truncation hint */
.footer-hint {
  margin: 48rpx 0 0;
  padding: 48rpx 32rpx;
  border: 2rpx dashed #d6dce4;
  border-radius: 24rpx;
  background: #fafbfc;
  text-align: center;
}

.footer-hint-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #6b7382;
}

.footer-hint-sub {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-hint);
}
